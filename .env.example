# Environment
ENVIRONMENT=development
DEBUG=true
APP_TITLE=SEO Service
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# PostgreSQL Database (seo_service)
POSTGRES_USER=eqsitecmsseo
POSTGRES_PASSWORD=eqsitecmsseo
POSTGRES_HOST=db-seo
POSTGRES_PORT=5432
POSTGRES_DB=seo_service

# NATS JetStream
NATS_SERVERS=nats://nats:4222
NATS_STREAM_SEO_TASKS=SEO_TASKS
NATS_ERROR_REPORT_AFTER_ATTEMPTS=3

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=eqsitecmsredis
REDIS_URL=redis://:eqsitecmsredis@redis:6379/0

# Celery
CELERY_BROKER_URL=redis://:eqsitecmsredis@redis:6379/0
CELERY_RESULT_BACKEND=redis://:eqsitecmsredis@redis:6379/0

# Service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO
