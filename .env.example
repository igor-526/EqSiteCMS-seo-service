ENVIRONMENT=development
DEBUG=true
APP_TITLE=EqSiteCMS SEO Service
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app

# Общий пояс всех конюшен; согласовать с YA_METRICA_UTC_OFFSET_HOURS исполнителя.
SEO_UTC_OFFSET_HOURS=3

YA_METRICA_SERVICE_URL=http://eqsitecms-ya-metrica-service:8000
YA_METRICA_TIMEOUT_SECONDS=4

# Источник привязок для ya_metrica; private peer без credentials.
YANDEX_SERVICE_URL=http://eqsitecms-yandex-service:8000
YANDEX_SERVICE_TIMEOUT_SECONDS=4

# Локальное ежедневное время HH:MM в SEO_UTC_OFFSET_HOURS.
# false отключает только расписание, ручной запуск остаётся доступен.
PARSE_SCHEDULE_ENABLED=true
PARSE_SCHEDULE_TIME=03:00
PARSE_SCHEDULER_TICK_SECONDS=30
# CSV зарегистрированных кодов; неизвестный/повторяющийся код блокирует старт.
PARSE_PROVIDERS_ENABLED=ya_metrica
PARSE_TARGETS_PAGE_SIZE=100
PARSE_DISPATCH_MAX_ATTEMPTS=5

# Внутренняя сеть, без auth; не публиковать NATS наружу.
NATS_SERVERS=nats://eqsitecms-nats:4222
# Stream принадлежит seo-service (API + scheduler); CSV subjects.
NATS_STREAM_PARSE_COMMANDS=PARSE_COMMANDS
# Значение с > не следует source-ить как shell-скрипт; это dotenv.
NATS_SUBJECTS_PARSE_COMMANDS=commands.parse.>
# Срок хранения команд — 7 суток.
NATS_PARSE_COMMANDS_MAX_AGE_SECONDS=604800
NATS_PUBLISH_TIMEOUT_SECONDS=5
# Порог эскалации ошибки соединения и bounded retry topology setup.
NATS_ERROR_REPORT_AFTER_ATTEMPTS=3
NATS_SETUP_MAX_ATTEMPTS=10
NATS_SETUP_BACKOFF_SECONDS=2
